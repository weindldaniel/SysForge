<Window x:Class="AnlageEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Anlagen-Editor" Height="760" Width="1500"
        Background="#F7F8F8" FontFamily="Segoe UI">

    <!-- Farbgebung Anwendung: RAL 3002 (Rot), RAL 9006 (Grau), RAL 7024 (Dunkelgrau-Blau) -->
    <Window.Resources>
        <SolidColorBrush x:Key="BgApp" Color="#F7F8F8"/>
        <SolidColorBrush x:Key="BgCard" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderGray" Color="#E4E4E4"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#45494E"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#787878"/>
        <SolidColorBrush x:Key="AccentRed" Color="#B20B10"/>
        <SolidColorBrush x:Key="AccentRedDark" Color="#8F090E"/>
        <SolidColorBrush x:Key="AccentRedLight" Color="#F7E3E3"/>
        <SolidColorBrush x:Key="AccentRedBorder" Color="#E4AAAB"/>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderGray}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="7,6"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderGray}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentRed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgApp}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentRed}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,4,0,14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentRedDark}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentRedDark}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentRedDark}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource AccentRedBorder}" BorderThickness="1" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentRedLight}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolboxItem" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderGray}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentRedLight}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentRedBorder}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModusToggle" TargetType="RadioButton">
            <Setter Property="Padding" Value="0,7"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{StaticResource BgApp}" BorderBrush="{StaticResource BorderGray}"
                                BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentRed}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentRed}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentRedBorder}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <!-- Linkes Metadaten-Panel -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Werkzeuge" Style="{StaticResource SectionHeader}"/>
                        <Border x:Name="ToolStation" Style="{StaticResource ToolboxItem}" Margin="0,0,0,10"
                                MouseLeftButtonDown="ToolStation_MouseLeftButtonDown">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="24" Height="17" RadiusX="3" RadiusY="3"
                                           Stroke="{StaticResource TextSecondary}" StrokeThickness="1"
                                           Fill="White" Margin="0,0,8,0"/>
                                <TextBlock Text="Station (auf Canvas ziehen)"
                                           Foreground="{StaticResource TextPrimary}"
                                           FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Klickmodus (Canvas)" Style="{StaticResource FieldLabel}"/>
                        <UniformGrid Columns="3">
                            <RadioButton x:Name="RbModusAuswahl" Content="Auswählen" GroupName="Modus"
                                         Style="{StaticResource ModusToggle}"
                                         Checked="Modus_Checked" Margin="0,0,3,0"/>
                            <RadioButton x:Name="RbModusVerbinden" Content="Verbinden" GroupName="Modus"
                                         Style="{StaticResource ModusToggle}"
                                         Checked="Modus_Checked" Margin="3,0,3,0"/>
                            <RadioButton x:Name="RbModusQuelle" Content="Quelle" GroupName="Modus"
                                         Style="{StaticResource ModusToggle}"
                                         Checked="Modus_Checked" Margin="3,0,0,0"/>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Beispielanlage" Style="{StaticResource SectionHeader}"/>
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"
                                   Text="Fiktive Anlage aus Kap. 4.3: Quelle → Stn 1 – Bohren → Stn 2 – Schweißen → Stn 3 – Fräsen → Senke"/>
                        <Button Content="Aufbauen &amp; simulieren" Click="FiktiveAnlageLaden_Click"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel x:Name="PropPanel" IsEnabled="False">
                        <TextBlock Text="Eigenschaften" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="Name" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtPropName" IsReadOnly="True" IsEnabled="False"/>
                        <TextBlock Text="µ (Erwartungswert)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtPropMu"/>
                        <TextBlock Text="σ (Standardabweichung)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtPropSigma"/>
                        <Button Content="Übernehmen" Margin="0,4,0,0" Click="PropUebernehmen_Click"/>
                        <Button Content="Löschen" Style="{StaticResource SecondaryButton}" Click="StationLoeschen_Click"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Materialfluss" Style="{StaticResource SectionHeader}"/>
                        <Button Content="▶ Abspielen" Click="MaterialflussAbspielen_Click"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Simulation" Style="{StaticResource SectionHeader}"/>

                        <TextBlock Text="Wiederholungen R" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtR" Text="100"/>
                        <TextBlock Style="{StaticResource FieldLabel}" FontStyle="Italic" TextWrapping="Wrap" Margin="0,-6,0,10"
                                   Text="Anzahl unabhängiger Simulationsläufe. Aus den R Lauf-Mittelwerten der Taktzeit wird das Konfidenzintervall berechnet – mehr Läufe verkleinern die Halbbreite."/>

                        <TextBlock Text="Teile je Lauf K" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtK" Text="200"/>
                        <TextBlock Style="{StaticResource FieldLabel}" FontStyle="Italic" TextWrapping="Wrap" Margin="0,-6,0,10"
                                   Text="Anzahl simulierter Werkstücke je Lauf. Davon werden die ersten „Warm-up“ Taktzeiten verworfen; aus den übrigen K − Warm-up wird der Lauf-Mittelwert gebildet."/>

                        <TextBlock Text="Warm-up" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtWarmup" Text="50"/>
                        <TextBlock Text="Konfidenzniveau" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtNiveau" Text="0,99"/>
                        <Button Content="Simulieren" Margin="0,4,0,0" Click="Simulieren_Click"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Status" Style="{StaticResource SectionHeader}"/>
                        <TextBlock x:Name="TxtErgebnis" TextWrapping="Wrap" Text="Bereit."
                                   Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Modellier-Canvas -->
        <Border Grid.Column="2" Background="{StaticResource BgCard}"
                BorderBrush="{StaticResource BorderGray}" BorderThickness="1" CornerRadius="8">
            <Canvas x:Name="ModellCanvas" Background="Transparent" ClipToBounds="True"
                    AllowDrop="True" DragOver="ModellCanvas_DragOver" Drop="ModellCanvas_Drop"/>
        </Border>

        <!-- Ergebnis-Panel (Stufe 1: Stationszeiten, Stufe 2: Gesamtanlagen-Taktzeit) -->
        <Border Grid.Column="4" Background="{StaticResource BgCard}"
                BorderBrush="{StaticResource BorderGray}" BorderThickness="1" CornerRadius="8" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Ergebnis" FontWeight="SemiBold" FontSize="16"
                               Foreground="{StaticResource TextPrimary}" Margin="0,0,0,4"/>
                    <TextBlock x:Name="TxtErgebnisHinweis" TextWrapping="Wrap" FontSize="12"
                               Foreground="{StaticResource TextSecondary}" Margin="0,0,0,16"
                               Text="Noch keine Simulation durchgeführt. Anlage aufbauen und auf „Simulieren“ klicken."/>

                    <StackPanel x:Name="PanelStufe1" Visibility="Collapsed">
                        <TextBlock Text="Stufe 1 – Stationszeiten" Style="{StaticResource SectionHeader}"/>
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource FieldLabel}" Margin="0,0,0,10"
                                   Text="Realisierte Bearbeitungszeiten je Station über alle R·K simulierten Werkstücke – Kontrolle, ob das Computermodell die konfigurierten µ/σ-Werte korrekt umsetzt."/>
                        <StackPanel x:Name="PanelStationszeiten" Margin="0,0,0,10"/>

                        <Button x:Name="BtnDetails" Content="Details anzeigen" Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Left" Margin="0,0,0,10" Click="BtnDetails_Click"/>

                        <StackPanel x:Name="PanelDetails" Visibility="Collapsed" Margin="0,0,0,16">
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="Lauf" VerticalAlignment="Center" Margin="0,0,8,0"
                                           Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="CmbLauf" Width="110" HorizontalAlignment="Left"
                                          SelectionChanged="CmbLauf_SelectionChanged"/>
                            </DockPanel>
                            <StackPanel x:Name="PanelLaufDetails"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="PanelStufe2" Visibility="Collapsed">
                        <TextBlock Text="Stufe 2 – Gesamtanlagen-Taktzeit" Style="{StaticResource SectionHeader}"/>
                        <StackPanel x:Name="PanelGesamtergebnis"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
